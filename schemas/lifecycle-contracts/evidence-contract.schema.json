{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillweave.dev/schemas/lifecycle/evidence-contract/v1",
  "title": "Evidence Contract",
  "description": "The proof a unit of work must attach before a gate may promote it. Evidence is described by kind, strength and the kernel stage that produced it. Evidence strength is a closed enum so an unknown strength fails closed rather than being treated as sufficient.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "requirements"],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/category"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "evidenceStrength": {
      "description": "Closed set of evidence strengths. Unknown strengths fail closed.",
      "enum": ["declared", "reproduced", "independently_verified"]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "strength"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "strength": {
          "$ref": "#/$defs/evidenceStrength"
        },
        "kernelStage": {
          "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/kernelStage"
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
