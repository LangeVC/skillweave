{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillweave.dev/schemas/lifecycle/work-profile/v1",
  "title": "Work Profile",
  "description": "Provider-neutral description of a unit of work: its category, the kernel stages it traverses, its execution topology and the surfaces it is allowed to change. Every enumerated field is closed; an unknown category, kernel stage, topology, human-coupling level or change surface is a validation failure rather than a silently tolerated extension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "category", "kernelStages"],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/category"
    },
    "kernelStages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/kernelStage"
      }
    },
    "topology": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/topology"
    },
    "humanCoupling": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/humanCoupling"
    },
    "changeSurfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/changeSurface"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
