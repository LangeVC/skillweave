{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1",
  "title": "Category Taxonomy",
  "description": "The closed vocabulary of work categories, kernel stages, execution topologies, human-coupling levels and change surfaces shared by every lifecycle contract. Unknown categories, kernel stages, topologies, human-coupling levels or change surfaces fail closed: the enums below are closed, so any value outside them is a validation error rather than a silently accepted extension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "categories", "kernelStages", "topologies", "humanCoupling", "changeSurfaces"],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "kernelStages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/kernelStage"
      }
    },
    "topologies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/topology"
      }
    },
    "humanCoupling": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/humanCoupling"
      }
    },
    "changeSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/changeSurface"
      }
    }
  },
  "$defs": {
    "category": {
      "description": "Closed set of work categories. Unknown categories fail closed.",
      "enum": [
        "research",
        "decide",
        "design",
        "author",
        "facilitate",
        "build",
        "transform",
        "assure",
        "operate",
        "publish",
        "learn"
      ]
    },
    "kernelStage": {
      "description": "Domain-neutral lifecycle kernel stages. Unknown stages fail closed.",
      "enum": ["K0", "K1", "K2", "K3", "K4", "K5", "K6"]
    },
    "topology": {
      "description": "Closed set of execution topologies. Unknown topologies fail closed.",
      "enum": [
        "linear",
        "iterative",
        "dag",
        "reactive",
        "continuous",
        "exploratory",
        "human_cadenced"
      ]
    },
    "humanCoupling": {
      "description": "Closed set of human-coupling levels. Unknown levels fail closed.",
      "enum": [
        "autonomous",
        "supervised",
        "approval_required",
        "collaborative",
        "human_led"
      ]
    },
    "changeSurface": {
      "description": "Closed set of change surfaces a run may mutate. Unknown surfaces fail closed.",
      "enum": [
        "code",
        "configuration",
        "infrastructure",
        "data",
        "documents",
        "knowledge",
        "public_channel",
        "external_system",
        "organization",
        "human",
        "finance",
        "legal"
      ]
    }
  }
}
