{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillweave.dev/schemas/lifecycle/deliverable-contract/v1",
  "title": "Deliverable Contract",
  "description": "What a unit of work promises to produce and what is required to accept it. A deliverable is described by category-neutral vocabulary: an artefact kind, an acceptance condition and the change surface it lands on. No field names a specific tool, host framework or provider.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "entrypoints"],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/category"
    },
    "changeSurfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/changeSurface"
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entrypoint"
      }
    }
  },
  "$defs": {
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "acceptance"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "surface": {
          "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/changeSurface"
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "kernelStage": {
          "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/kernelStage"
        }
      }
    }
  }
}
