{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillweave.dev/schemas/lifecycle/lifecycle-profile/v1",
  "title": "Lifecycle Profile",
  "description": "A named lifecycle: an ordered sequence of kernel stages, optionally labelled with legacy phase names. Legacy software delivery is representable without semantic loss because each of the seven software phases maps onto a kernel stage and keeps its original identifier, so a legacy consumer can still read discovery/blueprint/design/build/release/launch/post-release while a domain-neutral consumer reads only kernel stages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "phases"],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/category"
    },
    "topology": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/topology"
    },
    "humanCoupling": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/humanCoupling"
    },
    "changeSurfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/changeSurface"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "globalSkills": {
      "description": "Legacy-only notion: skills that sit outside the phase sequence and are invocable at any point in the lifecycle. Kept representable so a legacy substrate migrates without dropping them.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/globalSkill"
      }
    }
  },
  "$defs": {
    "globalSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "kernelStage"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "kernelStage": {
          "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/kernelStage"
        },
        "phaseType": {
          "description": "Legacy phase weighting. Optional; absent means the phase is unweighted.",
          "enum": ["optional", "recommended", "core"]
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
