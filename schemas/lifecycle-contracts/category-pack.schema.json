{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillweave.dev/schemas/lifecycle/category-pack/v1",
  "title": "Category Pack",
  "description": "A pack that adds lifecycle meaning for exactly one work category: its work profile, deliverables and evidence requirements. The category field is closed, so a pack claiming an unknown category fails closed. A pack may declare a standards baseline by reference only; it never embeds normative text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "category"],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/category"
    },
    "standardsBaselineRef": {
      "description": "Reference to an external standards baseline by identifier only. No normative text is embedded.",
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/topology"
    },
    "humanCoupling": {
      "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/humanCoupling"
    },
    "changeSurfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://skillweave.dev/schemas/lifecycle/category-taxonomy/v1#/$defs/changeSurface"
      }
    },
    "lifecycleProfile": {
      "type": "string",
      "minLength": 1
    },
    "workProfile": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
