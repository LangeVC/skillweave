{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillweave.dev/schemas/gate-1312-manifest/v1",
  "title": "SW-GATE-1312 machine-readable gate manifest",
  "type": "object",
  "required": ["schema_version", "gate", "shas", "commands", "evidence", "reviewer_brief"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "gate": {
      "type": "object",
      "required": ["id", "name", "base_sha", "subject_sha"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "subject_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "shas": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
    },
    "digests": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "exit"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "exit": { "type": "integer" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "reviewer_brief": {
      "type": "object",
      "required": ["digest"],
      "additionalProperties": false,
      "properties": {
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "deferrals": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
